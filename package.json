{
	"name": "pi-session-subagents",
	"version": "0.1.0",
	"description": "Session-scoped subagents for Pi with idle workers, steering, and native transcript inspection.",
	"type": "module",
	"license": "MIT",
	"author": "Rohit Bajaj",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rbajaj1997/pi-session-subagents.git"
	},
	"homepage": "https://github.com/rbajaj1997/pi-session-subagents#readme",
	"bugs": {
		"url": "https://github.com/rbajaj1997/pi-session-subagents/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"subagents",
		"session-workers"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check && tsc --noEmit",
		"format": "biome check --write",
		"test": "node --import tsx --test --test-timeout=10000 tests/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-agent-core": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@types/node": "^24.19.2",
		"tsx": "^4.23.15",
		"typebox": "1.3.27",
		"typescript": "^5.9.0"
	}
}
